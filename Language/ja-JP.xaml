<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xml:space="preserve">

    <system:String x:Key="SelectExRAddons">Extreme Rolesのアドオンの選択</system:String>
    <system:String x:Key="SelectExRAddonsHint">同時にインストールするアドオンにチェックを付けて、「インストール開始」を押してください。</system:String>
    <system:String x:Key="ExtremeSkinsHint">ハットやバイザー、ネームプレートを多数追加するアドオン</system:String>
    <system:String x:Key="ExtremeVoiceEngineHint">チャットを読み上げる機能を追加するアドオン</system:String>
    <system:String x:Key="InstallingHint">インストール中です… 終了までしばらくお待ちください。</system:String>
    <system:String x:Key="InstallButton">インストール開始</system:String>
    <system:String x:Key="CloseButton">終了</system:String>
    <system:String x:Key="CloseDialogButton">閉じる</system:String>
    <system:String x:Key="InstallLog">ログ</system:String>

    <system:String x:Key="InstallSuccess">インストール成功！！！</system:String>
    <system:String x:Key="InstallSuccessLocalBody">インターネット接続に問題があったため、ExtremeRolesの埋込されたバージョンをインストールしました。&#xa;「閉じるボタン」でこのダイアログを閉じることが出来ます</system:String>
    <system:String x:Key="InstallSuccessWebBody">ExtremeRolesの最新版のインストールに成功しました&#xa;「閉じるボタン」でこのダイアログを閉じることが出来ます</system:String>
    <system:String x:Key="ReleaseNotePlaceHolder">「{0}」のリリースノート</system:String>
    <system:String x:Key="InstallError">インストールに失敗しました・・・</system:String>
    <system:String x:Key="InstallErrorBody">何らかの原因でインストールに失敗しました。&#xa;再度実行しても同様である場合yukeijiに連絡して下さい。&#xa;このダイアログは「閉じるボタン」で閉じることが出来ます</system:String>

</ResourceDictionary>